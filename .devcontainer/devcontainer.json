{
  "name": "g2ray",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "sudo nohup /usr/local/bin/xray run -c /etc/xray/g2ray.json > /var/log/xray.log 2>&1 & sleep 5 && gh codespace ports visibility 443:public -c $CODESPACE_NAME",
  "portsAttributes": {
    "443": {
      "label": "g2ray",
      "protocol": "http",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
